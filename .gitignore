# Database files
*.db
*.sqlite
*.sqlite3
flokus.db
flokus_academy.db

# Python cache & build outputs
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment & Secrets
.env
.venv/
env/
venv/
.streamlit/secrets.toml

# Uploads & Temporary Scratch files
uploads/
scratch/

# OS specific files
.DS_Store
Thumbs.db
# Streamlit secrets anywhere in the tree (the rule above only matched the root)
**/.streamlit/secrets.toml

# SQLite point-in-time backups kept beside the live file
*.db.*-backup

# Session working space for undeletable files (this environment can move but not delete)
_to_delete/
